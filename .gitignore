# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# editors and OS
*~
*.swp
.DS_Store

# project specific
py-vs-r*/
scratch/
scratch*
benchmarks/results/*.tmp
benchmarks/results/tmp/
# stored R output for the test suite (a global *.gz ignore would hide it)
!tests/fixtures/*.json.gz
benchmarks/results/*.aborted.*
benchmarks/results/*.failed.*
# Beads / Dolt files (added by bd init); beads stays local, untracked
.beads/
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
# the Rust backend, built in place by make rust
src/pybiglasso/_rust*.so
rust/target/
